# ==============================================================================
#  Dango configuration — config.yaml (Docker / web dashboard path)
# ==============================================================================
#  Normally written for you by the web setup wizard at http://localhost:17860
#  (saved to data/config.yaml). For advanced / headless deploys, hand-write it:
#
#      cp config.yaml.example data/config.yaml   # then edit and start the bot
#
#  Every key maps to the matching UPPER_CASE env var (see .env.example and
#  docs/configuration/env-vars.md). The .env and config.yaml paths are mutually
#  exclusive — use one or the other.
# ==============================================================================

config_version: "1"

# ── Credentials ───────────────────────────────────────────────────────────────
discord_token: ""        # Discord bot token (required)
fast_api_key: ""         # API key for the fast model's provider (required)
deep_api_key: ""         # API key for the deep model; falls back to fast_api_key if empty

# ── Models (format: provider:model_id, e.g. google:gemini-2.5-flash) ──────────
fast_model: "google:gemini-2.5-flash"   # required
fast_base_url: ""        # custom endpoint, e.g. http://host.docker.internal:11434 for local Ollama
deep_model: ""           # optional; enables /deep and complexity routing
deep_base_url: ""

# ── Routing ───────────────────────────────────────────────────────────────────
auto_route: false        # auto-pick fast vs deep by message complexity (needs deep_model)
fallback_on_error: false # retry on the other model when one errors (needs deep_model)

# ── Bot behaviour ─────────────────────────────────────────────────────────────
chat_sys_prompt: "You are Dango, a helpful AI assistant on this Discord server. Always be polite and positive in your responses."
enable_contextual_system_prompt: true  # address users by name, inject time/participants
enable_message_batching: false  # merge rapid consecutive messages from one person into one reply
message_batch_window: 5         # seconds to wait for the next message (each new message resets it)
message_batch_max_wait: 15      # hard cap (seconds) on how long one burst is held

# ── Workspace (read-only access to a local folder) ────────────────────────────
enable_workspace: false
workspace_root: "workspace"
workspace_allowed: "read,list,search"

# ── Skills (on-demand SKILL.md folders; see docs/features/tools.md#skills) ────
enable_skills: false
skills_root: "skills"

# ── Web / search tools ────────────────────────────────────────────────────────
enable_duckduckgo: false     # free, no key
enable_brave_search: false   # needs brave_api_key
brave_api_key: ""
enable_website_tools: false  # fetch & read URLs from the conversation

# ── Custom tools ──────────────────────────────────────────────────────────────
enable_custom_apis: false
custom_apis: []
# custom_apis:
#   - name: "weather"
#     base_url: "https://api.example.com"
#     api_key: ""
#     description: "Weather lookup API"   # optional
enable_sql_databases: false
sql_databases: []
# sql_databases:
#   - name: "analytics"
#     db_url: "postgresql+psycopg://user:pass@host:5432/db"
#     description: "Read-only analytics DB"   # optional

# ── Shared model defaults (Gemini-specific unless noted) ──────────────────────
gemini_search: true            # Google Search grounding
gemini_url_context: false      # native URL fetching (google: models only)
gemini_grounding_threshold: "" # 0.0–1.0; empty = model default
gemini_thinking_budget: ""     # int; empty = model default
gemini_thinking_level: ""      # "low" | "high" | ""
context_token_budget: ""       # trim history to this many tokens; empty = no trim

# ── Large tool results ────────────────────────────────────────────────────────
# Results longer than this reach the model as a preview it can read further
# into; the full text sits in a temporary database deleted when the bot stops.
tool_result_offload_chars: ""  # characters; empty = 16000, 0 = always send in full
tool_result_ttl_seconds: ""    # how long stored results stay readable; empty = 3600, 0 = until exit

# ── Per-model overrides (empty = inherit the shared default above) ────────────
fast_search: ""
fast_url_context: ""
fast_grounding_threshold: ""
fast_thinking_budget: ""
fast_thinking_level: ""
fast_context_token_budget: ""

deep_search: ""
deep_url_context: ""
deep_grounding_threshold: ""
deep_thinking_budget: ""
deep_thinking_level: ""
deep_context_token_budget: ""
