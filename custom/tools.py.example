# Example custom agent tools. Copy to `tools.py` to activate:
#
#     cp custom/tools.py.example custom/tools.py
#
# Tools registered with @agent_tool are callable by the LLM during a chat turn,
# but are NOT exposed as Discord slash commands.

from dango.extensions import Ctx, agent_tool


# ── A pure agent tool (no Discord command) ───────────────────────────────────
# The docstring becomes the tool description and documents each argument for
# the model. Write it carefully — the LLM reads it to decide when/how to call.
@agent_tool()
def word_count(text: str) -> str:
    """Count the words and characters in a piece of text.

    Args:
        text: The text to analyze.
    """
    words = len(text.split())
    return f"{words} words, {len(text)} characters"


# ── A tool that uses Ctx to adapt to the caller ──────────────────────────────
# `ctx` is optional; declare it as the first parameter only if you need it.
# For agent calls, ctx.source == "agent" and channel/guild come from the
# current Discord message context.
@agent_tool(name="whoami", description="Report who is talking and where")
def whoami(ctx: Ctx) -> str:
    return (
        f"You are talking to {ctx.author_name} "
        f"in guild '{ctx.guild_name}' channel #{ctx.channel_name}."
    )


# ── Limit a tool to members with a Discord permission ────────────────────────
# requires_permissions is checked on every call, before the function runs. The
# caller's permissions come from Discord, not from the model. When they are
# missing the function is not called and the model is told why. Names are
# discord.py's: "manage_guild" is "Manage Server" in Discord.
@agent_tool(name="announce", requires_permissions="manage_guild")
def announce(ctx: Ctx, text: str) -> str:
    """Format a server-wide announcement. Only server managers may use it.

    Args:
        text: The announcement text.
    """
    return f"📢 Announcement from {ctx.author_name}: {text}"


# ── Agno @tool options pass through ───────────────────────────────────────────
# Other keyword arguments go to Agno's @tool, e.g. show_result, tool_hooks,
# stop_after_tool_call or cache_results. Human-in-the-loop options such as
# requires_confirmation are rejected: the Discord flow never resumes a paused
# run. cache_results is only allowed without ctx/requires_permissions, because
# the cache key ignores who is asking.
@agent_tool(name="char_table", cache_results=True, cache_ttl=3600)
def char_table(text: str) -> str:
    """Show the Unicode code point of each character in a short text.

    Args:
        text: The text to inspect (keep it short).
    """
    return "\n".join(f"{ch!r}: U+{ord(ch):04X}" for ch in text[:50])


