# ==============================================================================
#  Dango configuration — .env (uv / developer path)
# ==============================================================================
#  Copy this file to .env and fill in the blanks. Full reference:
#  docs/configuration/env-vars.md. The .env and data/config.yaml paths are
#  mutually exclusive — use one or the other.
# ==============================================================================

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Note: HISTORY_LIMIT, DISCORD_BOT_ACTIVITY, ALLOWED_CHANNELS, and ALLOWED_USERS
# are managed in config/runtime.yml and can be changed live via Discord commands
# (/sethistorylimit, /addchannel, /removechannel, /adduser, /removeuser).

# ── Fast Model ────────────────────────────────────────────────────────────────
# Format: provider:model_id
# Google:    google:gemma-4-31b-it | google:gemini-2.5-flash
# OpenAI:    openai:gpt-4o | openai:gpt-4o-mini
# Anthropic: anthropic:claude-sonnet-4-20250514
# Groq:      groq:llama-3.3-70b-versatile
FAST_MODEL=
FAST_API_KEY=
# Optional: override the provider's default endpoint.
# Use case: local inference server (Ollama / LM Studio / vLLM) running on the host machine.
#
# ⚠️  If the bot runs inside Docker and the inference server runs on the host,
#     use host.docker.internal instead of localhost / 127.0.0.1:
#       Ollama   → http://host.docker.internal:11434
#       LM Studio → http://host.docker.internal:1234/v1
#       vLLM     → http://host.docker.internal:8000/v1
#
# When not using Docker, use the server's actual address (e.g. http://localhost:11434).
# FAST_BASE_URL=

# ── Deep Model (optional) ─────────────────────────────────────────────────────
# Leave blank to disable dual-model routing entirely.
# When set, AUTO_ROUTE=on will route complex messages here; simple ones stay on FAST_MODEL.
DEEP_MODEL=
# Falls back to FAST_API_KEY if blank.
DEEP_API_KEY=
# DEEP_BASE_URL=

# ── Routing ───────────────────────────────────────────────────────────────────
# on/off — auto-route between fast and deep model based on message complexity.
# Has no effect when DEEP_MODEL is not set.
AUTO_ROUTE=off

# on/off — bidirectional error fallback between fast and deep model.
#   fast → deep: FAST_MODEL errors (e.g. 503) retry automatically then fall back to DEEP_MODEL.
#   deep → fast: DEEP_MODEL errors fall back to FAST_MODEL.
# Non-Gemini providers retry 2× before triggering fallback (Gemini handles its own retries).
# A [dango-sysinfo] note is sent to the channel when fallback succeeds.
# Has no effect when DEEP_MODEL is not set.
# Tip: works best when fast and deep use different providers — same-provider won't help
#       during provider-wide outages (a warning is printed at startup if this is the case).
FALLBACK_ON_ERROR=off

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
CHAT_SYS_PROMPT_PATH=config/chat_sys_prompt.txt
# on/off — address users by display name and include time/participant context
ENABLE_CONTEXTUAL_SYSTEM_PROMPT=on

# ── Message Batching ──────────────────────────────────────────────────────────
# on/off — coalesce rapid consecutive messages from the same person in the same
# channel into a single reply (Discord-style grouping). A burst opens on a
# message the bot would respond to and folds in every later message from that
# author until they pause.
ENABLE_MESSAGE_BATCHING=off
# Seconds to wait for the next message before sending. Each new message resets
# this window (sliding debounce) — i.e. "they stopped typing for this long".
MESSAGE_BATCH_WINDOW=5
# Hard cap (seconds) on how long one burst can be held, in case someone keeps
# typing without pausing. Measured from the first message of the burst.
MESSAGE_BATCH_MAX_WAIT=15

# ── Workspace Toolkit ─────────────────────────────────────────────────────────
# on/off — give the agent read access to a local directory tree
ENABLE_WORKSPACE=off
# Root directory the agent can access. Relative paths are resolved to absolute at startup.
# Default: a "workspace/" subfolder inside the project directory.
WORKSPACE_ROOT=workspace

# ── Skills ────────────────────────────────────────────────────────────────────
# on/off — let the agent load self-contained skills (each a folder with a
# SKILL.md) on demand. A malformed SKILL.md aborts startup with a clear error.
ENABLE_SKILLS=off
# Directory holding skill folders. Relative paths are resolved to absolute at startup.
# Default: a "skills/" subfolder inside the project directory.
SKILLS_ROOT=skills

# ── Web / Search Tools ────────────────────────────────────────────────────────
# on/off — let the agent search the web via DuckDuckGo and other free engines
# (no API key required)
ENABLE_DUCKDUCKGO=off
# on/off — let the agent search the web via the Brave Search API.
# Requires an API key (free tier available): https://brave.com/search/api/
ENABLE_BRAVE_SEARCH=off
BRAVE_API_KEY=
# on/off — let the agent fetch and read URLs shared in the conversation
# (no API key required)
ENABLE_WEBSITE_TOOLS=off

# ── Custom Tools ──────────────────────────────────────────────────────────────
# JSON array of REST APIs the agent can call. Each entry requires a unique "name".
# CUSTOM_APIS_JSON=[{"name": "weather", "base_url": "https://api.example.com", "api_key": ""}]
CUSTOM_APIS_JSON=[]

# JSON array of SQL databases the agent can query.
# See: https://docs.agno.com/features/context
# SQL_DATABASES_JSON=[{"name": "analytics", "db_url": "postgresql://user:pass@host/dbname"}]
SQL_DATABASES_JSON=[]

# ── Shared Defaults ───────────────────────────────────────────────────────────
# These apply to both models unless overridden by FAST_* or DEEP_* variants below.

# Search & grounding
# true/false — enable Google Search grounding (default: true)
GEMINI_SEARCH=true
# 0.0–1.0 — only apply grounding when confidence is below this threshold
GEMINI_GROUNDING_THRESHOLD=
# true/false — allow the model to fetch and read URLs mentioned in the conversation
# NOTE: only supported by Gemini models (not Gemma); set to false when using gemma-*
GEMINI_URL_CONTEXT=false

# Thinking (Gemini 2.5+ / Gemma 4)
# token budget for thinking (e.g. 1024, 8192); 0 disables thinking
GEMINI_THINKING_BUDGET=
# "low" or "high"
GEMINI_THINKING_LEVEL=

# Context window
# max input tokens sent to the model per request; 0 or unset = no limit
# When history exceeds this limit, oldest messages are dropped first.
CONTEXT_TOKEN_BUDGET=

# Large tool results (web pages, API responses)
# Results longer than this many characters reach the model as a short preview
# it can read further into; the full text sits in a temporary SQLite database
# that is deleted when the bot stops. Unset = 16000; 0 = always send in full.
TOOL_RESULT_OFFLOAD_CHARS=
# Seconds a stored result stays readable. Unset = 3600; 0 = until the bot stops.
TOOL_RESULT_TTL_SECONDS=

# ── Fast Model Overrides ──────────────────────────────────────────────────────
# Override the shared GEMINI_* defaults for the fast model only.
# Gemma 4 31B context: ~256k | Gemini 2.5 Flash: ~1M

# Search & grounding
FAST_SEARCH=
FAST_GROUNDING_THRESHOLD=
FAST_URL_CONTEXT=

# Thinking
FAST_THINKING_BUDGET=
FAST_THINKING_LEVEL=

# Context window
FAST_CONTEXT_TOKEN_BUDGET=

# ── Deep Model Overrides ──────────────────────────────────────────────────────
# Override the shared GEMINI_* defaults for the deep model only.
# Gemini 2.5 Pro context: ~2M | Gemini 2.5 Flash context: ~1M

# Search & grounding
DEEP_SEARCH=
DEEP_GROUNDING_THRESHOLD=
DEEP_URL_CONTEXT=

# Thinking
DEEP_THINKING_BUDGET=
DEEP_THINKING_LEVEL=

# Context window
DEEP_CONTEXT_TOKEN_BUDGET=

